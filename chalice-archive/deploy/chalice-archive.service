# /etc/systemd/system/chalice-archive.service: runs the archive server as its own unprivileged user,
# listening on loopback only, behind Caddy. deploy/README.md has the whole setup.
[Unit]
Description=Chalice Archive
After=network.target

[Service]
Type=simple
User=chalice
Group=chalice
WorkingDirectory=/opt/dezept-website/chalice-archive
ExecStart=/usr/bin/node /opt/dezept-website/chalice-archive/server/server.mjs
Environment=HOST=127.0.0.1 PORT=8080 TRUST_PROXY=true SESSION_HOURS=12
Environment=DATA_DIR=/var/lib/chalice-archive
# The address visitors use; logins and writes from anywhere else are refused.
Environment=PUBLIC_ORIGIN=https://archive.example.com
Restart=on-failure
RestartSec=2

# The records, the password hash and the backups live here, owned by chalice, mode 0700.
StateDirectory=chalice-archive
StateDirectoryMode=0700
UMask=0077

# Hardening: the process can read the code, write only its state directory, and talk only to loopback.
NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
RemoveIPC=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
SystemCallErrorNumber=EPERM
IPAddressDeny=any
IPAddressAllow=localhost
# scrypt needs 128 MiB per login check; checks run one at a time
MemoryMax=512M
# MemoryDenyWriteExecute stays off: Node's JavaScript engine compiles code at run time.

[Install]
WantedBy=multi-user.target
